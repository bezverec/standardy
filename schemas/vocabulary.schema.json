{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standardy.digitalizaty.cz/schemas/vocabulary.schema.json",
  "title": "Registry vocabulary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "title", "status", "verification", "values"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "vocabulary" },
    "id": { "$ref": "#/$defs/id" },
    "title": { "$ref": "#/$defs/localized" },
    "description": { "$ref": "#/$defs/localized" },
    "status": { "$ref": "#/$defs/status" },
    "verification": { "$ref": "#/$defs/verification" },
    "values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "label": { "$ref": "#/$defs/localized" },
          "description": { "$ref": "#/$defs/localized" },
          "deprecated": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "localized": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1 } },
    "status": { "enum": ["normative", "ambiguous", "disputed", "deprecated", "draft", "implementation_defined"] },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "date", "reference"],
      "properties": {
        "status": { "enum": ["verified", "unverified", "disputed"] },
        "date": { "type": ["string", "null"], "format": "date" },
        "reference": { "type": ["string", "null"] }
      }
    }
  }
}
