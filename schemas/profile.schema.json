{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standardy.digitalizaty.cz/schemas/profile.schema.json",
  "title": "Registry profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "title", "status", "verification", "versions"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "kind": { "const": "profile" },
    "id": { "$ref": "#/$defs/id" },
    "title": { "$ref": "#/$defs/localized" },
    "description": { "$ref": "#/$defs/localized" },
    "status": { "$ref": "#/$defs/status" },
    "verification": { "$ref": "#/$defs/verification" },
    "inherits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile", "version", "strategy"],
        "properties": {
          "profile": { "$ref": "#/$defs/id" },
          "version": { "type": "string", "minLength": 1 },
          "strategy": { "enum": ["inherit", "add", "restrict", "override", "extend"] }
        }
      }
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "status", "source"],
        "properties": {
          "version": { "type": "string", "minLength": 1 },
          "status": { "$ref": "#/$defs/status" },
          "introduced": { "type": ["string", "null"] },
          "deprecated": { "type": ["string", "null"] },
          "removed": { "type": ["string", "null"] },
          "source": { "$ref": "#/$defs/source" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "localized": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1 } },
    "status": { "enum": ["normative", "ambiguous", "disputed", "deprecated", "draft", "implementation_defined"] },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["document", "version", "page", "section", "url"],
      "properties": {
        "document": { "type": "string", "minLength": 1 },
        "version": { "type": ["string", "null"] },
        "page": { "type": ["string", "integer", "null"] },
        "section": { "type": ["string", "null"] },
        "url": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "date", "reference"],
      "properties": {
        "status": { "enum": ["verified", "unverified", "disputed"] },
        "date": { "type": ["string", "null"], "format": "date" },
        "reference": { "type": ["string", "null"] }
      }
    }
  }
}
